# Copy these values into backend/.env to run ParkPulse through Gemini on Vertex AI.
# Do not commit real service-account keys.

GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_API_VERSION=v1
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_FALLBACKS=gemini-2.0-flash

# Cost guardrail for the one-week timelapse demo profile.
# The Cloud Run deploy script defaults to this profile unless PARKPULSE_COST_PROFILE is overridden.
PARKPULSE_COST_PROFILE=weekly_25
PARKPULSE_WEEKLY_BUDGET_USD=25
PARKPULSE_TIMELAPSE_SIM_DAYS=7
PARKPULSE_TIMELAPSE_MAX_SIM_MINUTES=10080
PARKPULSE_TIMELAPSE_STORAGE_MODE=compact
PARKPULSE_TIMELAPSE_STORAGE_BUDGET_GB_PER_WEEK=5
PARKPULSE_TIMELAPSE_LLM_INTERVAL_MINUTES=15
PARKPULSE_TIMELAPSE_FULL_SNAPSHOT_INTERVAL_MINUTES=15
PARKPULSE_VERBOSE_ARTIFACT_RETENTION_DAYS=2

# Weekly budget defaults: keep the app usable, but avoid idle and hosted-eval spend.
PARKPULSE_CLOUD_RUN_MIN_INSTANCES=0
PARKPULSE_CLOUD_RUN_MAX_INSTANCES=2
PARKPULSE_CLOUD_RUN_CONCURRENCY=8
PARKPULSE_CLOUD_RUN_TIMEOUT=120
PARKPULSE_GEMINI_REACTION_TIMEOUT_SECONDS=8
PARKPULSE_GEMINI_REACTION_MAX_OUTPUT_TOKENS=900
ENABLE_GCP_CLOUD_TRACE_EXPORT=false
PARKPULSE_ENABLE_OTEL_SPANS=false
ENABLE_VERTEX_GENAI_EVAL=false
PARKPULSE_ENABLE_HOSTED_EVAL_TRIGGER=false
PARKPULSE_ENABLE_GCP_ML_TRAINING=false
PARKPULSE_ENABLE_REAL_BQML_START=false
PARKPULSE_READINESS_LOAD_BQ_ROWS=false

# Use one of these auth modes:
# 1. Local ADC:
#    gcloud auth application-default login
#
# 2. Service account JSON:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
#
# 3. Vertex AI express/service-account-bound API key if your project uses it:
# GOOGLE_API_KEY=your-vertex-compatible-api-key

PHOENIX_PROJECT_NAME=parkpulse-ai
PARKPULSE_ONLINE_IMPROVEMENT_PROVIDER=gcp
ENABLE_BIGQUERY_ANALYTICS=true
BIGQUERY_DATASET=parkpulse_analytics
BIGQUERY_LOCATION=US
BIGQUERY_AUTO_CREATE_TABLES=true

# Keep Arize disabled unless you intentionally want optional external traces.
ENABLE_ARIZE_TRACING=false
