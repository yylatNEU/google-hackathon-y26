# Gemini Enterprise Agent Platform / Gemini Enterprise API setup.
# This is the platform-level target for ParkPulse. The direct Gemini model
# endpoint remains only a local fallback.

AEROBRIDGE_AGENT_PLATFORM=gemini_enterprise
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Gemini Enterprise API locations are commonly global, us, or eu depending on
# how the app/engine is provisioned.
GOOGLE_CLOUD_LOCATION=global

# Default collection is normally used unless you created a custom collection.
GEMINI_ENTERPRISE_COLLECTION_ID=default_collection

# Fill these from the Gemini Enterprise / Agent Platform app you create.
GEMINI_ENTERPRISE_ENGINE_ID=your-engine-id
GEMINI_ENTERPRISE_ASSISTANT_ID=your-assistant-id

# Local auth:
#   gcloud auth application-default login
#
# Service-account auth:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

PHOENIX_PROJECT_NAME=parkpulse-ai
