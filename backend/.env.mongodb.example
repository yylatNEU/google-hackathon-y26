# MongoDB Atlas / local MongoDB connection for ParkPulse operational memory.
#
# Copy these into backend/.env and replace the URI with your real connection
# string. Keep this file public-safe; do not paste secrets here.

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DATABASE=parkpulse_ops
MONGODB_OPERATION_TIMEOUT_MS=5000

# Optional. If your Atlas cluster has a vectorSearch index over playbooks.embedding,
# set its name here. Otherwise the backend falls back to MongoDB text search or
# local keyword similarity.
MONGODB_PLAYBOOK_VECTOR_INDEX=playbook_vector_index

# Optional MongoDB Atlas / Voyage model API grounding.
# Keep disabled until the Atlas Vector Search indexes have been created for the
# configured modelEmbedding dimensions, then store the real key in Secret Manager.
PARKPULSE_COPILOT_SEMANTIC_MEMORY=false
PARKPULSE_COPILOT_HOT_PATH_LOCAL_ONLY=true
PARKPULSE_MONGO_MODEL_EMBEDDINGS=false
MONGODB_MODEL_API_KEY=your-mongodb-atlas-model-api-key
MONGODB_MODEL_EMBEDDING_ENDPOINT=https://ai.mongodb.com/v1/embeddings
MONGODB_MODEL_EMBEDDING_MODEL=voyage-4-lite
MONGODB_MODEL_EMBEDDING_DIMENSIONS=256
MONGODB_MODEL_EMBEDDING_PATH=modelEmbedding
MONGODB_MODEL_EMBEDDING_TIMEOUT_SECONDS=4
MONGODB_MODEL_QUERY_EMBEDDING_CACHE_TTL_SECONDS=60
PARKPULSE_COPILOT_SEMANTIC_MEMORY_TIMEOUT_SECONDS=2
PARKPULSE_COPILOT_SEMANTIC_MEMORY_CACHE_POLICY=role_cache_only

# Experience Studio production controls.
# Keep the role gate false for local hackathon demos; set true behind a real
# role/session issuer in production.
PARKPULSE_ENFORCE_EXPERIENCE_STUDIO_ROLES=false
PARKPULSE_EXPERIENCE_STUDIO_CORE_PATH=backend/data/experience_studio_core.v1.json
PARKPULSE_EXPERIENCE_STUDIO_MEMORY_FALLBACK_PATH=/tmp/parkpulse/experience_studio_memory_fallback.json

# Optional controls.
MONGODB_DISABLE_DECISION_WRITES=false
MONGODB_MIN_USEFUL_EVAL_SCORE=75
