{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bash scripts/dev-runtime.sh",
    "dev:local": "vite --host 0.0.0.0",
    "build": "bash scripts/build-runtime.sh",
    "build:local": "vite build",
    "start": "bash scripts/start-runtime.sh",
    "start:local": "vite preview --host 0.0.0.0",
    "typecheck": "bash scripts/typecheck-runtime.sh",
    "typecheck:local": "tsc --project tsconfig.typecheck.json --pretty false",
    "lint": "bash scripts/lint-runtime.sh",
    "lint:local": "eslint",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.1",
    "scheduler": "^0.27.0",
    "use-sync-external-store": "^1.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.0.14"
  }
}
