# Copy these values into backend/.env to run ParkPulse through Gemini on Vertex AI.
# Do not commit real service-account keys.

GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_API_VERSION=v1
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_FALLBACKS=gemini-2.0-flash

# Use one of these auth modes:
# 1. Local ADC:
#    gcloud auth application-default login
#
# 2. Service account JSON:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
#
# 3. Vertex AI express/service-account-bound API key if your project uses it:
# GOOGLE_API_KEY=your-vertex-compatible-api-key

PHOENIX_PROJECT_NAME=parkpulse-ai
PARKPULSE_ONLINE_IMPROVEMENT_PROVIDER=gcp
ENABLE_BIGQUERY_ANALYTICS=true
BIGQUERY_DATASET=parkpulse_analytics
BIGQUERY_LOCATION=US
BIGQUERY_AUTO_CREATE_TABLES=true

# Keep Arize disabled unless you intentionally want optional external traces.
ENABLE_ARIZE_TRACING=false
