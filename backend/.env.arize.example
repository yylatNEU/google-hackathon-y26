# Arize AX tracing setup.
# Copy these into backend/.env only when you intentionally want outbound traces.
# Keep this file public-safe; do not paste real secrets here.

ENABLE_ARIZE_TRACING=true
PARKPULSE_ENABLE_OPTIONAL_ARIZE=true
ARIZE_PROJECT_NAME=aerobridge-ai
ARIZE_SPACE_ID=your-arize-space-id
ARIZE_API_KEY=your-arize-api-key
ARIZE_COLLECTOR_ENDPOINT=https://otlp.arize.com/v1/traces

# Pipeline controls.
# useful: exports API/user/demo spans and background-loop spans only when they
# create new signals. all/raw: exports every span.
ARIZE_EXPORT_POLICY=useful
ARIZE_EXPORT_BACKGROUND_SPANS=false
